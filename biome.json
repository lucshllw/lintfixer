{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/core/**/*.ts",
      "packages/adapters/**/*.ts",
      "packages/cli/**/*.ts",
      "packages/github-action/**/*.ts",
      "packages/lintfixer/**/*.ts",
      "packages/desktop-ui/src/**/*.ts",
      "packages/desktop-ui/src/**/*.tsx",
      "*.ts",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
